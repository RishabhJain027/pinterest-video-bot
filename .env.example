# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# 1. Open Telegram, search @BotFather, send /newbot to create your bot
# 2. Copy the bot token and paste it below:
BOT_TOKEN=your_telegram_bot_token_here

# Maximum video size allowed for download/upload (Telegram bot limit is 50MB)
MAX_DOWNLOAD_MB=45

# ==============================================================================
# Cloud Webhook Deployment (Optional - Leave blank for Local Polling mode)
# ==============================================================================
# If running on Render or any cloud server with a public domain, set these:
# PUBLIC_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=your_custom_secret_key_here
# BOT_MODE=polling  # or webhook

